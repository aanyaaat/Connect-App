<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Partner Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aanya &amp; Me ❤️"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Connected · Live"
                android:textColor="#F43F5E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Latest Partner Moment / Glance -->
    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="Thinking of you right now ❤️"
        android:textColor="#E2E8F0"
        android:textSize="12sp" />

    <!-- Quick Direct Actions Row (Lock Screen / Home Screen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_love"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="#E11D48"
            android:text="💖 Love"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_doodle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="#7C3AED"
            android:text="🎨 Doodle"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_touch"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="#BE185D"
            android:text="💓 Touch"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/widget_btn_home"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="#1E1B4B"
            android:text="🏠 Home"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
