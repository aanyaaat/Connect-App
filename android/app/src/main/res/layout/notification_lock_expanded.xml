<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <!-- Header / Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_title_exp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aanya &amp; Me"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_status_exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected ❤️"
            android:textSize="11sp"
            android:textColor="#CCF43F5E"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Subtitle / Connection Details -->
    <TextView
        android:id="@+id/notif_subtitle_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connected with Partner — Moments ready"
        android:textSize="12sp"
        android:textColor="#B0FFFFFF"
        android:layout_marginTop="2dp" />

    <!-- Help Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send quick love instantly or draw live together on the shared canvas."
        android:textSize="11sp"
        android:textColor="#80FFFFFF"
        android:layout_marginTop="4dp" />

    <!-- ⚡ Interactive Action Buttons Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- Action 1: Quick Message 1 -->
        <TextView
            android:id="@+id/btn_notif_quick_1_exp"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:text="❤️ Love"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Action 2: Quick Message 2 -->
        <TextView
            android:id="@+id/btn_notif_quick_2_exp"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:text="✨ Miss You"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Action 3: Quick Message 3 -->
        <TextView
            android:id="@+id/btn_notif_quick_3_exp"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:text="🤗 Hug"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
