<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/doodle_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aanya &amp; Me — Live Doodle"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Realtime"
            android:textSize="11sp"
            android:textColor="#CCF43F5E"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/doodle_notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shared two-way canvas with your partner"
        android:textSize="11sp"
        android:textColor="#B0FFFFFF"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="1dp" />

    <!-- 🎨 Dedicated Full-Width Draw Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_doodle_card_draw"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_notif_btn_accent"
            android:gravity="center"
            android:text="🎨 Tap to Draw Live on Lock Screen"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
